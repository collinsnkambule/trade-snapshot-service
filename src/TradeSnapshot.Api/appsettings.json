{
  "ConnectionStrings": {
    "TradeSnapshot": "Server=(localdb)\\MSSQLLocalDB;Database=TradeSnapshot;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "TradeIngestion": {
    "CorrectionHandling": {
      "Mode": "Enabled",
      "PilotAccounts": []
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "TradeSnapshot.Api.Observability.CorrelationIdMiddleware": "Information"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffZ",
        "JsonWriterOptions": { "Indented": false }
      }
    }
  },
  "AllowedHosts": "*"
}
